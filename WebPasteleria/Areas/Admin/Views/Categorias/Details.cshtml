@model CategoriaProducto
@{
    ViewBag.Title = "Detalle de categoría";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header"><h3>Detalle de categoría</h3></div>

    <dl class="admin-details">
        <dt>ID</dt><dd>@Model.Id</dd>
        <dt>Nombre</dt><dd>@Model.Nombre</dd>
        <dt>Estado</dt><dd>@(Model.Estado == EstadoRegistro.Activo ? "Activa" : "Inactiva")</dd>
    </dl>

    <div class="admin-form-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn admin-btn-primary">Editar</a>
        <a asp-action="Index" class="admin-btn admin-btn-secondary">Volver</a>
    </div>
</div>
