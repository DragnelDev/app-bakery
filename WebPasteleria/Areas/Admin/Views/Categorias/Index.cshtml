@model IEnumerable<CategoriaProducto>
@{
    ViewBag.Title = "Categorías";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header">
        <h3>Categorías de productos</h3>
        <a asp-action="Create" class="admin-btn admin-btn-primary"><i class="fas fa-plus"></i> Nueva categoría</a>
    </div>

    <table class="data-table">
        <thead>
            <tr><th>ID</th><th>Nombre</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="admin-empty">No hay categorías registradas</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>
                        <span class="status-badge @(item.Estado == EstadoRegistro.Activo ? "delivered" : "pending")">
                            @(item.Estado == EstadoRegistro.Activo ? "Activa" : "Inactiva")
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
