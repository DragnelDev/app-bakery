@model WebPasteleria.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="delete-header">
    <div>
        <h1><i class="fas fa-trash-alt"></i> Eliminar Producto</h1>
        <p class="subtitle">Esta acción dará de baja el producto del sistema</p>
    </div>
</div>

<div class="delete-container">
    <div class="warning-card">
        <div class="warning-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="warning-content">
            <h3>¿Estás seguro que deseas dar de baja este producto?</h3>
            <p>Esta acción cambiará el estado del producto a inactivo.</p>
        </div>
    </div>

    <div class="delete-card">
        <div class="product-preview">
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="preview-image" />
            }
            else
            {
                <div class="preview-placeholder">
                    <i class="fas fa-cake-candles"></i>
                </div>
            }
            <div class="preview-info">
                <h2>@Model.Nombre</h2>
                <span class="preview-code">@Model.Codigo</span>
            </div>
        </div>

        <div class="details-grid">
            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-list"></i> Categoría
                </span>
                <span class="detail-value">
                    @(Model.IdCategoriaNavigation?.Nombre ?? "Sin categoría")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-balance-scale"></i> Unidad de Medida
                </span>
                <span class="detail-value">
                    @Model.UnidadMedida
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-dollar-sign"></i> Precio
                </span>
                <span class="detail-value price">
                    Bs. @Model.Precio.ToString("N2")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-boxes"></i> Stock
                </span>
                <span class="detail-value">
                    @Model.Stock unidades
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-shapes"></i> Tipo
                </span>
                <span class="detail-value">
                    @Model.Tipo
                </span>
            </div>

            <div class="detail-item full-width">
                <span class="detail-label">
                    <i class="fas fa-align-left"></i> Descripción
                </span>
                <span class="detail-value">
                    @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-user"></i> Usuario Registro
                </span>
                <span class="detail-value">
                    @Model.UsuarioRegistro
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">
                    <i class="fas fa-calendar"></i> Fecha Registro
                </span>
                <span class="detail-value">
                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div class="detail-item full-width">
                    <span class="detail-label">
                        <i class="fas fa-image"></i> URL de Imagen
                    </span>
                    <span class="detail-value url">
                        @Model.ImagenUrl
                    </span>
                </div>
            }
        </div>

        <div class="action-section">
            <form asp-action="Delete" class="delete-form">
                <input type="hidden" asp-for="Id" />
                <div class="form-buttons">
                    <a asp-action="Index" class="btn-delete-confirm">
                        <i class="fa fa-trash"></i> Confirmar Eliminación
                    </a>
                    <a asp-action="Index" class="btn-cancel">
                        <i class="fa fa-arrow-left"></i> Cancelar y Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .delete-header {
            margin-bottom: 30px;
        }

        .delete-header h1 {
            color: #d32f2f;
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

        .delete-header h1 i {
            margin-right: 10px;
        }

        .subtitle {
            color: #666;
            margin: 5px 0 0 0;
            font-size: 14px;
        }

        .delete-container {
            max-width: 900px;
        }

        .warning-card {
            background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
            border: 2px solid #f39c12;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.2);
        }

        .warning-icon {
            width: 70px;
            height: 70px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .warning-icon i {
            font-size: 36px;
            color: #f39c12;
        }

        .warning-content h3 {
            color: #856404;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

        .warning-content p {
            color: #856404;
            margin: 0;
            font-size: 14px;
        }

        .delete-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .product-preview {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-bottom: 30px;
            margin-bottom: 30px;
            border-bottom: 2px solid #f0f0f0;
        }

        .preview-image {
            width: 100px;
            height: 100px;
            border-radius: 15px;
            object-fit: cover;
            border: 3px solid #f0f0f0;
        }

        .preview-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 15px;
            background: linear-gradient(135deg, #ffc0cb 0%, #ffb6c1 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 40px;
        }

        .preview-info h2 {
            color: #333;
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

        .preview-code {
            background: #f0f0f0;
            padding: 5px 12px;
            border-radius: 6px;
            font-weight: 600;
            color: #555;
            font-size: 13px;
            font-family: 'Courier New', monospace;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 30px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .detail-item.full-width {
            grid-column: 1 / -1;
        }

        .detail-label {
            color: #999;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-label i {
            color: #ff69b4;
        }

        .detail-value {
            color: #333;
            font-size: 15px;
            font-weight: 500;
        }

        .detail-value.price {
            color: #2ecc71;
            font-size: 18px;
            font-weight: 700;
        }

        .detail-value.url {
            color: #3498db;
            word-break: break-all;
            font-size: 13px;
        }

        .action-section {
            padding-top: 30px;
            border-top: 2px solid #f0f0f0;
        }

        .delete-form {
            width: 100%;
        }

        .form-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-delete-confirm {
            flex: 1;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 14px 30px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
            transition: all 0.3s ease;
        }

        .btn-delete-confirm:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
        }

        .btn-cancel {
            flex: 1;
            background: #f5f5f5;
            color: #666;
            padding: 14px 30px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .btn-cancel:hover {
            background: #e0e0e0;
            color: #333;
        }

        (max-width:768px)
        {
        .delete-card {
            padding: 25px;
        }

        .warning-card {
            flex-direction: column;
            text-align: center;
        }

        .product-preview {
            flex-direction: column;
            text-align: center;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .form-buttons {
            flex-direction: column;
        }
    }
</style>
}