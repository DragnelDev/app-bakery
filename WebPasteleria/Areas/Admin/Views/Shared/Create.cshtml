@model WebPasteleria.Models.Empleado

@{
    ViewData["Title"] = "Nuevo Empleado";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .pasteleria-container {
        background: linear-gradient(135deg, #ffeef8 0%, #ffd4e5 100%);
        min-height: 100vh;
        padding: 40px 20px;
    }
    
    .form-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 10px 40px rgba(255, 105, 180, 0.2);
        padding: 40px;
        max-width: 700px;
        margin: 0 auto;
        border: 3px solid #ffb3d9;
    }
    
    .header-section {
        text-align: center;
        margin-bottom: 35px;
    }
    
    .header-section h1 {
        color: #d63384;
        font-weight: 700;
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(214, 51, 132, 0.1);
    }
    
    .header-section h4 {
        color: #ff69b4;
        font-weight: 500;
        font-size: 1.3rem;
        margin-bottom: 5px;
    }
    
    .cupcake-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }
    
    .divider {
        height: 3px;
        background: linear-gradient(90deg, transparent, #ffb3d9, transparent);
        border: none;
        margin: 25px 0;
    }
    
    .form-group {
        margin-bottom: 25px;
    }
    
    .form-group label {
        color: #d63384;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        font-size: 0.95rem;
    }
    
    .required-field::after {
        content: " *";
        color: #dc3545;
        font-weight: 700;
    }
    
    .form-control {
        border: 2px solid #ffc0e0;
        border-radius: 12px;
        padding: 12px 18px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: #fff5fb;
        width: 100%;
    }
    
    .form-control:focus {
        border-color: #ff69b4;
        box-shadow: 0 0 0 0.2rem rgba(255, 105, 180, 0.25);
        background-color: white;
        outline: none;
    }
    
    .form-control.input-validation-error {
        border-color: #dc3545;
    }
    
    .form-control::placeholder {
        color: #ffb3d9;
    }
    
    .text-danger {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }
    
    .btn-submit {
        background: linear-gradient(135deg, #ff69b4 0%, #d63384 100%);
        border: none;
        color: white;
        padding: 14px 40px;
        border-radius: 25px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(255, 105, 180, 0.3);
        width: 100%;
        margin-top: 20px;
    }
    
    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 105, 180, 0.4);
        background: linear-gradient(135deg, #d63384 0%, #ff69b4 100%);
    }
    
    .btn-back {
        display: inline-block;
        color: #d63384;
        text-decoration: none;
        font-weight: 600;
        margin-top: 20px;
        padding: 10px 25px;
        border-radius: 20px;
        border: 2px solid #ffb3d9;
        transition: all 0.3s ease;
        text-align: center;
    }
    
    .btn-back:hover {
        background-color: #ffe0f0;
        color: #d63384;
        text-decoration: none;
        border-color: #ff69b4;
    }
    
    .back-section {
        text-align: center;
        margin-top: 25px;
    }
    
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    
    .validation-summary-errors {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border: 2px solid #f5c2c7;
        border-radius: 15px;
        padding: 15px 20px;
        margin-bottom: 25px;
        color: #721c24;
        font-weight: 500;
    }
    
    .validation-summary-errors ul {
        margin: 0;
        padding-left: 20px;
    }
    
    media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }
        
        .form-card {
            padding: 25px;
        }
        
        .header-section h1 {
            font-size: 2rem;
        }
    }
</style>

<div class="pasteleria-container">
    <div class="form-card">
        <div class="header-section">
            <div class="cupcake-icon">🧁</div>
            <h1>Nuevo Empleado</h1>
            <h4>Registro de Personal</h4>
        </div>
        
        <hr class="divider" />
        
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="CedulaIdentidad" class="control-label required-field">Cédula de Identidad</label>
                <input asp-for="CedulaIdentidad" class="form-control" placeholder="Ej: 1234567" />
                <span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label required-field">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Juan" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="ApellidoPaterno" class="control-label required-field">Apellido Paterno</label>
                    <input asp-for="ApellidoPaterno" class="form-control" placeholder="García" />
                    <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ApellidoMaterno" class="control-label">Apellido Materno</label>
                    <input asp-for="ApellidoMaterno" class="form-control" placeholder="López" />
                    <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="FechaNacimiento" class="control-label required-field">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>
            </div>
            
            <div class="form-group">
                <label asp-for="Direccion" class="control-label required-field">Dirección</label>
                <input asp-for="Direccion" class="form-control" placeholder="Calle principal 123, Apartamento 4B" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Celular" class="control-label required-field">Celular</label>
                    <input asp-for="Celular" class="form-control" placeholder="67890123" />
                    <span asp-validation-for="Celular" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Email" class="control-label required-field">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            
            <div class="form-group">
                <label asp-for="Cargo" class="control-label required-field">Cargo</label>
                <input asp-for="Cargo" class="form-control" placeholder="Repostero, Panadero, Vendedor, etc." />
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn-submit">✨ Registrar Empleado</button>
            </div>
        </form>
        
        <div class="back-section">
            <a asp-action="Index" class="btn-back">← Volver al Listado</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}