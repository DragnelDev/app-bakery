@model IEnumerable<WebPasteleria.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="clientes-header">
    <div>
        <h1><i class="fas fa-users"></i> Gestión de Clientes</h1>
        <p class="subtitle">Administra la base de datos de clientes de Pastelería Carmen</p>
    </div>
    <a asp-action="Create" class="btn-create">
        <i class="fa fa-plus"></i> Nuevo Cliente
    </a>
</div>

<div class="clientes-container">
    <div class="table-card">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>CI</th>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="ci-badge">@item.CedulaIdentidad</span>
                                </td>
                                <td>
                                    <div class="cliente-info">
                                        <div class="cliente-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <strong>@item.Nombre @item.Apellido</strong>
                                            <small>@item.Direccion</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="contacto-info">
                                        @if (!string.IsNullOrEmpty(item.Celular))
                                        {
                                            <span class="contacto-item">
                                                <i class="fas fa-phone"></i> @item.Celular
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <span class="contacto-item">
                                                <i class="fas fa-envelope"></i> @item.Email
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (item.TipoCliente == "VIP")
                                    {
                                        <span class="tipo-badge vip">
                                            <i class="fas fa-crown"></i> VIP
                                        </span>
                                    }
                                    else if (item.TipoCliente == "Frecuente")
                                    {
                                        <span class="tipo-badge frecuente">
                                            <i class="fas fa-star"></i> Frecuente
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tipo-badge regular">
                                            <i class="fas fa-user"></i> Regular
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Estado == 1)
                                    {
                                        <span class="estado-badge activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view"
                                            title="Ver Detalles">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" title="Editar">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete"
                                            title="Eliminar">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="fas fa-user-friends"></i>
                                <p>No hay clientes registrados</p>
                                <a asp-action="Create" class="btn-create-small">Registrar primer cliente</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .clientes-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .clientes-header h1 {
            color: #c71585;
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

        .clientes-header h1 i {
            margin-right: 10px;
        }

        .subtitle {
            color: #666;
            margin: 5px 0 0 0;
            font-size: 14px;
        }

        .btn-create {
            background: linear-gradient(135deg, #ff69b4 0%, #ff1493 100%);
            color: white;
            padding: 12px 24px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(255, 105, 180, 0.3);
            transition: all 0.3s ease;
        }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 105, 180, 0.4);
            color: white;
        }

        .clientes-container {
            background: white;
            border-radius: 15px;
            padding: 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .table-card {
            padding: 0;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .modern-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .modern-table thead {
            background: linear-gradient(90deg, #ff69b4 0%, #ff1493 100%);
        }

        .modern-table th {
            padding: 18px 15px;
            text-align: left;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: white;
            white-space: nowrap;
        }

        .modern-table tbody tr {
            border-bottom: 1px solid #f0f0f0;
            transition: all 0.2s ease;
        }

        .modern-table tbody tr:hover {
            background: #fff5f8;
        }

        .modern-table td {
            padding: 15px;
            vertical-align: middle;
        }

        .ci-badge {
            background: #f0f0f0;
            padding: 5px 12px;
            border-radius: 6px;
            font-weight: 600;
            color: #555;
            font-size: 13px;
            font-family: 'Courier New', monospace;
        }

        .cliente-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .cliente-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ffb6c1 0%, #ffc0cb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            flex-shrink: 0;
        }

        .cliente-info div {
            display: flex;
            flex-direction: column;
        }

        .cliente-info strong {
            color: #333;
            font-size: 14px;
        }

        .cliente-info small {
            color: #999;
            font-size: 12px;
        }

        .contacto-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .contacto-item {
            color: #666;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .contacto-item i {
            color: #ff69b4;
            font-size: 12px;
        }

        .tipo-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-transform: uppercase;
        }

        .tipo-badge.vip {
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            color: #856404;
        }

        .tipo-badge.frecuente {
            background: #e3f2fd;
            color: #1976d2;
        }

        .tipo-badge.regular {
            background: #f5f5f5;
            color: #666;
        }

        .estado-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .estado-badge.activo {
            background: #d1e7dd;
            color: #0f5132;
        }

        .estado-badge.inactivo {
            background: #f8d7da;
            color: #842029;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn-action {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 14px;
        }

        .btn-view {
            background: #e3f2fd;
            color: #1976d2;
        }

        .btn-view:hover {
            background: #1976d2;
            color: white;
            transform: translateY(-2px);
        }

        .btn-edit {
            background: #fff3e0;
            color: #f57c00;
        }

        .btn-edit:hover {
            background: #f57c00;
            color: white;
            transform: translateY(-2px);
        }

        .btn-delete {
            background: #ffebee;
            color: #d32f2f;
        }

        .btn-delete:hover {
            background: #d32f2f;
            color: white;
            transform: translateY(-2px);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px !important;
        }

        .empty-state i {
            font-size: 64px;
            color: #ddd;
            margin-bottom: 20px;
        }

        .empty-state p {
            color: #999;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .btn-create-small {
            background: linear-gradient(135deg, #ff69b4 0%, #ff1493 100%);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
        }

        .text-center {
            text-align: center;
        }

        media (max-width: 768px) {
            .clientes-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .modern-table {
                font-size: 12px;
            }

            .modern-table th,
            .modern-table td {
                padding: 10px 8px;
            }

            .cliente-avatar {
                width: 40px;
                height: 40px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }
    </style>
}