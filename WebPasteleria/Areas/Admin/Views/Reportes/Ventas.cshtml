@model ReporteVentasViewModel
@{
    ViewBag.Title = "Reporte de ventas";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<partial name="_ReportesTabs" />

<div class="card">
    <div class="admin-page-header">
        <h3>Ventas por día</h3>
    </div>
    <partial name="_FiltroFechas" model="Model.Rango" />

    <table class="data-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Pedidos</th>
                <th>Total (Bs)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Filas.Count == 0)
            {
                <tr>
                    <td colspan="3" class="admin-empty">No hay ventas en el rango seleccionado</td>
                </tr>
            }
            @foreach (var fila in Model.Filas)
            {
                <tr>
                    <td>@fila.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@fila.Pedidos</td>
                    <td>@fila.Total.ToString("N2")</td>
                </tr>
            }
            @if (Model.Filas.Count > 0)
            {
                <tr class="admin-total-row">
                    <td>Total</td>
                    <td>@Model.TotalPedidos</td>
                    <td>@Model.TotalGeneral.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted" style="margin-top: 10px; font-size: 13px;">No incluye pedidos cancelados.</p>
</div>
