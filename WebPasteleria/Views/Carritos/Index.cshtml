@{
    ViewData["Title"] = "Carrito de Compras - Pastelería Carmen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="background-color: #ffe4f0;">
    <!-- Cart Sidebar (Mini Cart) -->
    <div class="wrap-header-cart js-panel-cart">
        <div class="s-full js-hide-cart"></div>

        <div class="header-cart flex-col-l p-l-65 p-r-25">
            <div class="header-cart-title flex-w flex-sb-m p-b-8">
                <span class="mtext-103 cl2">
                    Tu Carrito
                </span>

                <div class="fs-35 lh-10 cl2 p-lr-5 pointer hov-cl1 trans-04 js-hide-cart">
                    <i class="zmdi zmdi-close"></i>
                </div>
            </div>

            <div class="header-cart-content flex-w js-pscroll">
                <ul class="header-cart-wrapitem w-full" id="mini-cart-items">
                    <!-- Mini cart items -->
                </ul>

                <div class="w-full">
                    <div class="header-cart-total w-full p-tb-40" id="mini-cart-total">
                        Total: 0 Bs
                    </div>

                    <div class="header-cart-buttons flex-w w-full">
                        <a asp-controller="Carritos" asp-action="Index"
                           class="flex-c-m stext-101 cl0 size-107 bor2 hov-btn3 p-lr-15 trans-04 m-r-8 m-b-10"
                           style="background-color: #ff91c7; border-color: #ff91c7;">
                            Ver Carrito
                        </a>

                        <a asp-controller="Pedidos" asp-action="Checkout"
                           class="flex-c-m stext-101 cl0 size-107 bor2 hov-btn3 p-lr-15 trans-04 m-b-10"
                           style="background-color: #ff91c7; border-color: #ff91c7;">
                            Finalizar Compra
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Breadcrumb -->
    <div class="container">
        <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
            <a asp-controller="Home" asp-action="Index" class="stext-109 cl8 hov-cl1 trans-04">
                Inicio
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>

            <span class="stext-109 cl4">
                Carrito de Compras
            </span>
        </div>
    </div>

    <!-- Shopping Cart -->
    <div class="p-t-75 p-b-85">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 col-xl-7 m-lr-auto m-b-50">
                    <div class="m-l-25 m-r--38 m-lr-0-xl">
                        <!-- Cart Items Table -->
                        <div class="wrap-table-shopping-cart"
                             style="background-color: #fff; border-radius: 10px; padding: 20px;">
                            <div id="cart-empty-message" class="text-center p-t-50 p-b-50" style="display: none;">
                                <i class="zmdi zmdi-shopping-cart" style="font-size: 80px; color: #ff91c7;"></i>
                                <h3 class="mtext-111 cl2 p-t-20">Tu carrito está vacío</h3>
                                <p class="stext-113 cl6 p-b-20">Agrega algunos productos deliciosos</p>
                                <a asp-controller="Productos" asp-action="Index"
                                   class="flex-c-m stext-101 cl0 size-103 bor1 hov-btn1 p-lr-15 trans-04"
                                   style="background-color: #ff91c7; border-color: #ff91c7; display: inline-block;">
                                    Ver Productos
                                </a>
                            </div>

                            <table class="table-shopping-cart" id="cart-table">
                                <thead>
                                    <tr class="table_head">
                                        <th class="column-1">Producto</th>
                                        <th class="column-2"></th>
                                        <th class="column-3">Precio</th>
                                        <th class="column-4">Cantidad</th>
                                        <th class="column-5">Total</th>
                                        <th class="column-6"></th>
                                    </tr>
                                </thead>
                                <tbody id="cart-items-body">
                                    <!-- Cart items will be loaded here -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Coupon and Update Cart -->
                        <div class="flex-w flex-sb-m bor15 p-t-18 p-b-15 p-lr-40 p-lr-15-sm"
                             style="background-color: #fff; border-radius: 10px; margin-top: 20px;" id="cart-actions">
                            <div class="flex-w flex-m m-r-20 m-tb-5">
                                <input class="stext-104 cl2 plh4 size-117 bor13 p-lr-20 m-r-10 m-tb-5" type="text"
                                       id="coupon-code" placeholder="Código de Cupón" style="border-color: #ff91c7;">

                                <button
                                    class="flex-c-m stext-101 cl0 size-118 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-5"
                                    id="apply-coupon-btn" style="background-color: #ff91c7; border-color: #ff91c7;">
                                    Aplicar Cupón
                                </button>
                            </div>

                            <button
                                class="flex-c-m stext-101 cl2 size-119 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-10"
                                id="update-cart-btn" style="border-color: #ff91c7; color: #ff91c7;">
                                Actualizar Carrito
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cart Totals -->
                <div class="col-sm-10 col-lg-7 col-xl-5 m-lr-auto m-b-50">
                    <div class="bor10 p-lr-40 p-t-30 p-b-40 m-l-63 m-r-40 m-lr-0-xl p-lr-15-sm"
                         style="background-color: #fff; border-radius: 10px; border-color: #ff91c7;" id="cart-summary">
                        <h4 class="mtext-109 cl2 p-b-30">
                            Resumen del Pedido
                        </h4>

                        <div class="flex-w flex-t bor12 p-b-13">
                            <div class="size-208">
                                <span class="stext-110 cl2">
                                    Subtotal:
                                </span>
                            </div>

                            <div class="size-209">
                                <span class="mtext-110 cl2" id="subtotal-amount">
                                    0.00 Bs
                                </span>
                            </div>
                        </div>

                        <div class="flex-w flex-t bor12 p-t-15 p-b-13" id="discount-section" style="display: none;">
                            <div class="size-208">
                                <span class="stext-110 cl2">
                                    Descuento:
                                </span>
                            </div>

                            <div class="size-209">
                                <span class="mtext-110" style="color: #28a745;" id="discount-amount">
                                    -0.00 Bs
                                </span>
                            </div>
                        </div>

                        <div class="flex-w flex-t bor12 p-t-15 p-b-30">
                            <div class="size-208 w-full-ssm">
                                <span class="stext-110 cl2">
                                    Envío:
                                </span>
                            </div>

                            <div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
                                <div class="p-t-15">
                                    <div class="bor8 bg0 m-b-12">
                                        <select class="stext-111 cl2 plh3 size-111 p-lr-15" id="shipping-method">
                                            <option value="0">Recoger en tienda - Gratis</option>
                                            <option value="15">Entrega a domicilio (Zona Centro) - 15 Bs</option>
                                            <option value="25">Entrega a domicilio (Fuera de zona) - 25 Bs</option>
                                        </select>
                                    </div>

                                    <p class="stext-112 cl6 p-t-10">
                                        <i class="fa fa-map-marker" style="color: #ff91c7;"></i>
                                        Av. Jaime Mendoza 456, Sucre
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="flex-w flex-t p-t-27 p-b-33">
                            <div class="size-208">
                                <span class="mtext-101 cl2">
                                    Total:
                                </span>
                            </div>

                            <div class="size-209 p-t-1">
                                <span class="mtext-110" style="color: #ff91c7;" id="total-amount">
                                    0.00 Bs
                                </span>
                            </div>
                        </div>

                        <a asp-controller="Pedidos" asp-action="Checkout"
                           class="flex-c-m stext-101 cl0 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer"
                           id="checkout-btn" style="background-color: #ff91c7; border-color: #ff91c7;">
                            Proceder al Pago
                        </a>

                        <a asp-controller="Productos" asp-action="Index"
                           class="flex-c-m stext-101 cl2 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer m-t-15"
                           style="border-color: #ff91c7; color: #ff91c7; display: block; text-align: center;">
                            Seguir Comprando
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Variables globales
        let carrito = JSON.parse(localStorage.getItem('carrito')) || [];
        let descuentoActual = 0;
        let codigoCuponAplicado = '';

        // Cupones válidos
        const cupones = {
            'CARMEN10': { tipo: 'porcentaje', valor: 10, descripcion: '10% de descuento' },
            'CARMEN20': { tipo: 'porcentaje', valor: 20, descripcion: '20% de descuento' },
            'DULCE50': { tipo: 'monto', valor: 50, descripcion: '50 Bs de descuento' },
            'PRIMERA100': { tipo: 'monto', valor: 100, descripcion: '100 Bs de descuento' }
        };

        // Renderizar carrito completo
        function renderizarCarrito() {
            const cartItemsBody = document.getElementById('cart-items-body');
            const cartEmptyMessage = document.getElementById('cart-empty-message');
            const cartTable = document.getElementById('cart-table');
            const cartActions = document.getElementById('cart-actions');
            const cartSummary = document.getElementById('cart-summary');

            if (carrito.length === 0) {
                cartEmptyMessage.style.display = 'block';
                cartTable.style.display = 'none';
                cartActions.style.display = 'none';
                cartSummary.style.display = 'none';
                actualizarMiniCarrito();
                return;
            }

            cartEmptyMessage.style.display = 'none';
            cartTable.style.display = 'table';
            cartActions.style.display = 'flex';
            cartSummary.style.display = 'block';

            let html = '';
            carrito.forEach((item, index) => {
                const subtotal = item.precio * item.cantidad;
                html += `
                        <tr class="table_row">
                            <td class="column-1">
                                <div class="how-itemcart1">
                                    <img src="${item.imagen}" alt="${item.nombre}" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
                                </div>
                            </td>
                            <td class="column-2">${item.nombre}</td>
                            <td class="column-3">${item.precio.toFixed(2)} Bs</td>
                            <td class="column-4">
                                <div class="wrap-num-product flex-w m-l-auto m-r-0">
                                    <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m" data-index="${index}">
                                        <i class="fs-16 zmdi zmdi-minus"></i>
                                    </div>

                                    <input class="mtext-104 cl3 txt-center num-product"
                                           type="number"
                                           value="${item.cantidad}"
                                           min="1"
                                           data-index="${index}">

                                    <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m" data-index="${index}">
                                        <i class="fs-16 zmdi zmdi-plus"></i>
                                    </div>
                                </div>
                            </td>
                            <td class="column-5">${subtotal.toFixed(2)} Bs</td>
                            <td class="column-6">
                                <button class="btn-remove-item" data-index="${index}" style="border: none; background: none; color: #ff91c7; cursor: pointer; font-size: 20px;">
                                    <i class="zmdi zmdi-close"></i>
                                </button>
                            </td>
                        </tr>
                    `;
            });

            cartItemsBody.innerHTML = html;

            // Event listeners para cantidad
            document.querySelectorAll('.btn-num-product-down').forEach(btn => {
                btn.addEventListener('click', function () {
                    const index = parseInt(this.getAttribute('data-index'));
                    if (carrito[index].cantidad > 1) {
                        carrito[index].cantidad--;
                        guardarCarrito();
                        renderizarCarrito();
                    }
                });
            });

            document.querySelectorAll('.btn-num-product-up').forEach(btn => {
                btn.addEventListener('click', function () {
                    const index = parseInt(this.getAttribute('data-index'));
                    carrito[index].cantidad++;
                    guardarCarrito();
                    renderizarCarrito();
                });
            });

            document.querySelectorAll('.num-product').forEach(input => {
                input.addEventListener('change', function () {
                    const index = parseInt(this.getAttribute('data-index'));
                    const nuevaCantidad = parseInt(this.value);
                    if (nuevaCantidad > 0) {
                        carrito[index].cantidad = nuevaCantidad;
                        guardarCarrito();
                        renderizarCarrito();
                    }
                });
            });

            // Event listeners para eliminar
            document.querySelectorAll('.btn-remove-item').forEach(btn => {
                btn.addEventListener('click', function () {
                    const index = parseInt(this.getAttribute('data-index'));
                    const nombreProducto = carrito[index].nombre;

                    if (confirm(`¿Estás seguro de eliminar "${nombreProducto}" del carrito?`)) {
                        carrito.splice(index, 1);
                        guardarCarrito();
                        renderizarCarrito();
                        swal("Eliminado", "Producto eliminado del carrito", "success");
                    }
                });
            });

            actualizarTotales();
            actualizarMiniCarrito();
        }

        // Actualizar totales
        function actualizarTotales() {
            const subtotal = carrito.reduce((total, item) => total + (item.precio * item.cantidad), 0);
            const shippingMethod = document.getElementById('shipping-method');
            const envio = parseFloat(shippingMethod.value);

            // Calcular descuento
            let descuento = 0;
            if (codigoCuponAplicado && cupones[codigoCuponAplicado]) {
                const cupon = cupones[codigoCuponAplicado];
                if (cupon.tipo === 'porcentaje') {
                    descuento = subtotal * (cupon.valor / 100);
                } else {
                    descuento = cupon.valor;
                }
            }

            const total = subtotal - descuento + envio;

            document.getElementById('subtotal-amount').textContent = subtotal.toFixed(2) + ' Bs';
            document.getElementById('total-amount').textContent = total.toFixed(2) + ' Bs';

            // Mostrar/ocultar sección de descuento
            const discountSection = document.getElementById('discount-section');
            if (descuento > 0) {
                discountSection.style.display = 'flex';
                document.getElementById('discount-amount').textContent = '-' + descuento.toFixed(2) + ' Bs';
            } else {
                discountSection.style.display = 'none';
            }
        }

        // Actualizar mini carrito
        function actualizarMiniCarrito() {
            const miniCartItems = document.getElementById('mini-cart-items');
            const miniCartTotal = document.getElementById('mini-cart-total');

            if (carrito.length === 0) {
                miniCartItems.innerHTML = '<li class="p-lr-15 p-tb-20"><p class="stext-113 cl6">Tu carrito está vacío</p></li>';
                miniCartTotal.textContent = 'Total: 0 Bs';
                document.querySelector('.js-show-cart').setAttribute('data-notify', '0');
                return;
            }

            let html = '';
            let total = 0;

            carrito.forEach((item, index) => {
                const subtotal = item.precio * item.cantidad;
                total += subtotal;

                html += `
                        <li class="header-cart-item flex-w flex-t m-b-12">
                            <div class="header-cart-item-img">
                                <img src="${item.imagen}" alt="${item.nombre}" style="width: 80px; height: 80px; object-fit: cover;">
                            </div>
                            <div class="header-cart-item-txt p-t-8">
                                <a href="#" class="header-cart-item-name m-b-18 hov-cl1 trans-04">
                                    ${item.nombre}
                                </a>
                                <span class="header-cart-item-info">
                                    ${item.cantidad} x ${item.precio.toFixed(2)} Bs
                                </span>
                            </div>
                        </li>
                    `;
            });

            miniCartItems.innerHTML = html;
            miniCartTotal.textContent = `Total: ${total.toFixed(2)} Bs`;
            document.querySelector('.js-show-cart').setAttribute('data-notify', carrito.length);
        }

        // Guardar carrito
        function guardarCarrito() {
            localStorage.setItem('carrito', JSON.stringify(carrito));
        }

        // Aplicar cupón
        function aplicarCupon() {
            const codigoCupon = document.getElementById('coupon-code').value.toUpperCase().trim();

            if (!codigoCupon) {
                swal("Error", "Por favor ingresa un código de cupón", "error");
                return;
            }

            if (!cupones[codigoCupon]) {
                swal("Error", "Código de cupón inválido", "error");
                return;
            }

            if (codigoCuponAplicado === codigoCupon) {
                swal("Info", "Este cupón ya está aplicado", "info");
                return;
            }

            codigoCuponAplicado = codigoCupon;
            const cupon = cupones[codigoCupon];

            swal("¡Cupón aplicado!", cupon.descripcion, "success");
            actualizarTotales();
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', function () {
            renderizarCarrito();

            // Cambio en método de envío
            document.getElementById('shipping-method').addEventListener('change', actualizarTotales);

            // Aplicar cupón
            document.getElementById('apply-coupon-btn').addEventListener('click', aplicarCupon);

            // Actualizar carrito
            document.getElementById('update-cart-btn').addEventListener('click', function () {
                renderizarCarrito();
                swal("Actualizado", "Carrito actualizado correctamente", "success");
            });

            // Proceder al checkout
            document.getElementById('checkout-btn').addEventListener('click', function (e) {
                if (carrito.length === 0) {
                    e.preventDefault();
                    swal("Carrito vacío", "Agrega productos antes de continuar", "warning");
                }
            });
        });
    </script>
}