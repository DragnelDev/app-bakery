@model ReporteClientesViewModel
@{
    ViewBag.Title = "Clientes frecuentes";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<partial name="_ReportesTabs" />

<div class="card">
    <div class="admin-page-header">
        <h3>Clientes frecuentes</h3>
    </div>
    <partial name="_FiltroFechas" model="Model.Rango" />

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Correo</th>
                <th>Pedidos</th>
                <th>Total gastado (Bs)</th>
                <th>Último pedido</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Filas.Count == 0)
            {
                <tr>
                    <td colspan="6" class="admin-empty">No hay pedidos en el rango seleccionado</td>
                </tr>
            }
            @for (var i = 0; i < Model.Filas.Count; i++)
            {
                var fila = Model.Filas[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@fila.Nombre</td>
                    <td>@fila.Email</td>
                    <td>@fila.Pedidos</td>
                    <td>@fila.TotalGastado.ToString("N2")</td>
                    <td>@fila.UltimoPedido.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
