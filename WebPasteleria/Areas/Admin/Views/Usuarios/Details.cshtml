@model Usuario
@{
    ViewBag.Title = "Detalle de usuario";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header">
        <h3>Detalle de usuario</h3>
    </div>

    <dl class="admin-details">
        <dt>Usuario</dt>
        <dd>@Model.Usuario1</dd>
        <dt>Empleado</dt>
        <dd>@Model.IdEmpleadoNavigation.Nombre @Model.IdEmpleadoNavigation.ApellidoPaterno</dd>
        <dt>Rol</dt>
        <dd>@Model.Role</dd>
        <dt>Último acceso</dt>
        <dd>@(Model.UltimoLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
        <dt>Intentos fallidos</dt>
        <dd>@(Model.IntentosFallidos ?? 0)</dd>
        <dt>Registrado por</dt>
        <dd>@Model.UsuarioRegistro el @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt>Estado</dt>
        <dd>@(Model.Estado == EstadoRegistro.Activo ? "Activo" : "Inactivo")</dd>
    </dl>

    <div class="admin-form-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn admin-btn-primary">Editar</a>
        <a asp-action="Index" class="admin-btn admin-btn-secondary">Volver</a>
    </div>
</div>
