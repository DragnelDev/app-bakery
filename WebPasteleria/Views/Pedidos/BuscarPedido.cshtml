@{
    ViewData["Title"] = "Rastrear Pedido - Pastelería Carmen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="background-color: #ffe4f0; min-height: 100vh;">
    <!-- Breadcrumb -->
    <div class="container">
        <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
            <a asp-controller="Home" asp-action="Index" class="stext-109 cl8 hov-cl1 trans-04">
                Inicio
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>

            <span class="stext-109 cl4">
                Rastrear Pedido
            </span>
        </div>
    </div>

    <!-- Search Section -->
    <div class="container p-t-75 p-b-85">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Banner de búsqueda -->
                <div class="text-center m-b-50">
                    <div style="font-size: 80px; color: #ff91c7;">
                        <i class="fa fa-search"></i>
                    </div>
                    <h2 class="ltext-105 cl2 m-t-20" style="color: #ff91c7;">
                        Rastrea tu Pedido
                    </h2>
                    <p class="stext-113 cl6 m-t-10">
                        Ingresa tu código de seguimiento o email para ver el estado de tu pedido
                    </p>
                </div>

                <!-- Formulario de búsqueda -->
                <div class="bor10 p-lr-40 p-t-40 p-b-40 m-b-30" style="background-color: #fff; border-radius: 10px; border-color: #ff91c7;">
                    <form asp-controller="Pedidos" asp-action="Seguimiento" method="get">
                        <div class="row">
                            <div class="col-12 m-b-30">
                                <label class="stext-111 cl2 p-b-10">
                                    <i class="fa fa-barcode" style="color: #ff91c7;"></i>
                                    Código de Seguimiento *
                                </label>
                                <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8"
                                       type="text"
                                       name="codigo"
                                       id="codigo-seguimiento"
                                       placeholder="Ejemplo: ABC12345"
                                       style="text-transform: uppercase;"
                                       required
                                       maxlength="20">
                                <small class="stext-112 cl6 p-t-5">
                                    El código de seguimiento lo recibiste en tu email de confirmación
                                </small>
                            </div>

                            <div class="col-12 text-center">
                                <button type="submit"
                                        class="flex-c-m stext-101 cl0 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer"
                                        style="background-color: #ff91c7; border-color: #ff91c7; width: 100%; max-width: 300px;">
                                    <i class="fa fa-search"></i> Buscar Pedido
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Divider -->
                    <div class="flex-c-m p-t-30 p-b-30">
                        <div style="flex: 1; height: 1px; background-color: #e5e5e5;"></div>
                        <span class="stext-111 cl6 p-lr-20">O</span>
                        <div style="flex: 1; height: 1px; background-color: #e5e5e5;"></div>
                    </div>

                    <!-- Búsqueda por Email -->
                    <form asp-controller="Pedidos" asp-action="BuscarPorEmail" method="post">
                        <div class="row">
                            <div class="col-12 m-b-20">
                                <label class="stext-111 cl2 p-b-10">
                                    <i class="fa fa-envelope" style="color: #ff91c7;"></i>
                                    Correo Electrónico
                                </label>
                                <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8"
                                       type="email"
                                       name="email"
                                       id="email-cliente"
                                       placeholder="correo@ejemplo.com"
                                       required>
                                <small class="stext-112 cl6 p-t-5">
                                    Te mostraremos todos los pedidos asociados a este correo
                                </small>
                            </div>

                            <div class="col-12 text-center">
                                <button type="submit"
                                        class="flex-c-m stext-101 cl2 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer"
                                        style="border-color: #ff91c7; color: #ff91c7; width: 100%; max-width: 300px;">
                                    <i class="fa fa-list"></i> Ver Mis Pedidos
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Ayuda -->
                <div class="bor10 p-lr-40 p-t-30 p-b-30" style="background-color: #fff; border-radius: 10px; border-color: #ff91c7;">
                    <h5 class="mtext-110 cl2 m-b-20">
                        <i class="fa fa-question-circle" style="color: #ff91c7;"></i> ¿No encuentras tu código?
                    </h5>

                    <div class="row">
                        <div class="col-md-6 m-b-20">
                            <div class="p-all-15" style="background-color: #fff5f8; border-radius: 8px;">
                                <h6 class="stext-111 cl2 m-b-10">
                                    <i class="fa fa-envelope" style="color: #ff91c7;"></i> Revisa tu Email
                                </h6>
                                <p class="stext-112 cl6">
                                    El código de seguimiento fue enviado al correo que proporcionaste al hacer el pedido.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6 m-b-20">
                            <div class="p-all-15" style="background-color: #fff5f8; border-radius: 8px;">
                                <h6 class="stext-111 cl2 m-b-10">
                                    <i class="fa fa-phone" style="color: #ff91c7;"></i> Contáctanos
                                </h6>
                                <p class="stext-112 cl6">
                                    Llámanos al <strong>(+591) 4 645-7890</strong> o escríbenos por WhatsApp.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información Adicional -->
                <div class="text-center m-t-30">
                    <p class="stext-113 cl6">
                        <i class="fa fa-info-circle" style="color: #ff91c7;"></i>
                        Los pedidos pueden tardar de 24 a 48 horas en ser preparados
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Convertir código a mayúsculas automáticamente
        document.getElementById('codigo-seguimiento').addEventListener('input', function(e) {
            e.target.value = e.target.value.toUpperCase();
        });
    </script>
}