@model Usuario
@{
    ViewBag.Title = "Eliminar usuario";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header">
        <h3>Eliminar usuario</h3>
    </div>

    <p>¿Seguro que deseas eliminar al usuario <strong>@Model.Usuario1</strong> (@Model.Role)?</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-danger">Eliminar</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
