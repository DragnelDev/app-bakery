@model CategoriaProducto
@{
    ViewBag.Title = "Eliminar categoría";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header"><h3>Eliminar categoría</h3></div>

    <p>¿Seguro que deseas eliminar la categoría <strong>@Model.Nombre</strong>?</p>
    <p class="text-muted">No se podrá eliminar si tiene productos asociados.</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-danger">Eliminar</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
