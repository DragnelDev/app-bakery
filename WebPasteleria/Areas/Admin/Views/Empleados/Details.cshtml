@model WebPasteleria.Models.Empleado

@{
    ViewData["Title"] = "Detalles del Empleado";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .pasteleria-container {
        background: linear-gradient(135deg, #ffeef8 0%, #ffd4e5 100%);
        min-height: 100vh;
        padding: 40px 20px;
    }
    
    .details-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 10px 40px rgba(255, 105, 180, 0.2);
        padding: 0;
        max-width: 900px;
        margin: 0 auto;
        border: 3px solid #ffb3d9;
        overflow: hidden;
    }
    
    .card-header {
        background: linear-gradient(135deg, #ff69b4 0%, #d63384 100%);
        padding: 35px 40px;
        text-align: center;
        position: relative;
    }
    
    .header-icon {
        font-size: 3.5rem;
        margin-bottom: 15px;
        filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.2));
    }
    
    .card-header h1 {
        color: white;
        font-weight: 700;
        font-size: 2.3rem;
        margin: 0 0 10px 0;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }
    
    .card-header h4 {
        color: rgba(255, 255, 255, 0.95);
        font-weight: 500;
        font-size: 1.2rem;
        margin: 0;
    }
    
    .card-body {
        padding: 40px;
    }
    
    .info-section {
        margin-bottom: 30px;
    }
    
    .section-title {
        color: #d63384;
        font-weight: 700;
        font-size: 1.3rem;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #ffe0f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }
    
    .info-item {
        background: #fff5fb;
        padding: 20px;
        border-radius: 15px;
        border: 2px solid #ffe0f0;
        transition: all 0.3s ease;
    }
    
    .info-item:hover {
        border-color: #ffb3d9;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 105, 180, 0.15);
    }
    
    .info-item.full-width {
        grid-column: 1 / -1;
    }
    
    .info-label {
        color: #d63384;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }
    
    .info-value {
        color: #333;
        font-size: 1.1rem;
        font-weight: 500;
        word-break: break-word;
    }
    
    .badge-estado {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    
    .badge-activo {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }
    
    .badge-inactivo {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }
    
    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 35px;
        padding-top: 30px;
        border-top: 2px solid #ffe0f0;
        flex-wrap: wrap;
    }
    
    .btn-action {
        padding: 14px 35px;
        border-radius: 25px;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }
    
    .btn-edit {
        background: linear-gradient(135deg, #0dcaf0 0%, #0891b2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(13, 202, 240, 0.3);
    }
    
    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(13, 202, 240, 0.4);
        color: white;
        text-decoration: none;
    }
    
    .btn-back {
        background: white;
        color: #d63384;
        border: 2px solid #ffb3d9;
        box-shadow: 0 4px 15px rgba(255, 105, 180, 0.2);
    }
    
    .btn-back:hover {
        background: #fff5fb;
        border-color: #ff69b4;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 105, 180, 0.3);
        color: #d63384;
        text-decoration: none;
    }
    
    .employee-name {
        background: linear-gradient(135deg, #ffe0f0 0%, #ffc0e0 100%);
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        margin-bottom: 30px;
        border: 2px solid #ffb3d9;
    }
    
    .employee-name h2 {
        color: #d63384;
        font-weight: 700;
        font-size: 1.8rem;
        margin: 0;
    }
    
    media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
        
        .card-body {
            padding: 25px;
        }
        
        .card-header {
            padding: 25px 20px;
        }
        
        .card-header h1 {
            font-size: 1.8rem;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .btn-action {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="pasteleria-container">
    <div class="details-card">
        <div class="card-header">
            <div class="header-icon">👤</div>
            <h1>Detalles del Empleado</h1>
            <h4>Información Completa del Personal</h4>
        </div>
        
        <div class="card-body">
            <div class="employee-name">
                <h2>@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</h2>
            </div>
            
            <div class="info-section">
                <div class="section-title">
                    <span>📋</span> Información Personal
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Cédula de Identidad</span>
                        <div class="info-value">@Html.DisplayFor(model => model.CedulaIdentidad)</div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Fecha de Nacimiento</span>
                        <div class="info-value">@Html.DisplayFor(model => model.FechaNacimiento)</div>
                    </div>
                    <div class="info-item full-width">
                        <span class="info-label">Dirección</span>
                        <div class="info-value">@Html.DisplayFor(model => model.Direccion)</div>
                    </div>
                </div>
            </div>
            
            <div class="info-section">
                <div class="section-title">
                    <span>📞</span> Información de Contacto
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Celular</span>
                        <div class="info-value">@Html.DisplayFor(model => model.Celular)</div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Correo Electrónico</span>
                        <div class="info-value">@Html.DisplayFor(model => model.Email)</div>
                    </div>
                </div>
            </div>
            
            <div class="info-section">
                <div class="section-title">
                    <span>💼</span> Información Laboral
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Cargo</span>
                        <div class="info-value">@Html.DisplayFor(model => model.Cargo)</div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Estado</span>
                        <div class="info-value">
                            @if (Model.Estado == 1)
                            {
                                <span class="badge-estado badge-activo">✓ Activo</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-inactivo">✕ Inactivo</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="info-section">
                <div class="section-title">
                    <span>📝</span> Información de Registro
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Usuario que Registró</span>
                        <div class="info-value">@Html.DisplayFor(model => model.UsuarioRegistro)</div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Fecha de Registro</span>
                        <div class="info-value">@Html.DisplayFor(model => model.FechaRegistro)</div>
                    </div>
                </div>
            </div>
            
            <div class="action-buttons">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-action btn-edit">
                    ✏️ Editar Empleado
                </a>
                <a asp-action="Index" class="btn-action btn-back">
                    ← Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>