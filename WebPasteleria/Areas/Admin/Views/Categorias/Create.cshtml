@model CategoriaFormViewModel
@{
    ViewBag.Title = "Nueva categoría";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header"><h3>Nueva categoría</h3></div>

    <form asp-action="Create" method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="admin-summary-error"></div>

        <div class="admin-field">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" type="text" maxlength="50" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Guardar</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
