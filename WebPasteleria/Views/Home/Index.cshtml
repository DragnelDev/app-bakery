@model IEnumerable<WebPasteleria.Models.Producto>

@{
    ViewData["Title"] = "Inicio - Pastelería Carmen";
}

<section style="background-color: #ffe4f0;">
    <!-- Slider -->
    <section class="section-slide">
        <div class="wrap-slick1">
            <div class="slick1">
                <div class="item-slick1"
                     style="background-image: url(~/images/slide-01.jpg); background-position: center;">
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                                <span class="ltext-101 respon2"
                                      style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Pastelería Carmen
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                                <h2 class="ltext-201 p-t-19 p-b-43 respon1"
                                    style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Tortas Artesanales
                                </h2>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
                                <a asp-controller="Productos" asp-action="Index"
                                   class="flex-c-m stext-101 cl0 size-101 bor1 hov-btn1 p-lr-15 trans-04"
                                   style="background-color: #ff91c7; border-color: #ff91c7;">
                                    Comprar Ahora
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="item-slick1"
                     style="background-image: url(~/images/slide-02.jpg); background-position: center;">
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
                                <span class="ltext-101 respon2"
                                      style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Nuevas Creaciones
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn"
                                 data-delay="800">
                                <h2 class="ltext-201 p-t-19 p-b-43 respon1"
                                    style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Cupcakes Decorados
                                </h2>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="slideInUp" data-delay="1600">
                                <a asp-controller="Productos" asp-action="PorCategoria" asp-route-categoria="Cupcakes"
                                   class="flex-c-m stext-101 cl0 size-101 bor1 hov-btn1 p-lr-15 trans-04"
                                   style="background-color: #ff91c7; border-color: #ff91c7;">
                                    Ver Cupcakes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="item-slick1"
                     style="background-image: url(~/images/slide-03.jpg); background-position: center;">
                    <div class="container h-full">
                        <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                            <div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft"
                                 data-delay="0">
                                <span class="ltext-101 respon2"
                                      style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Especialidad de la Casa
                                </span>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight"
                                 data-delay="800">
                                <h2 class="ltext-201 p-t-19 p-b-43 respon1"
                                    style="color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                                    Tartas y Pays
                                </h2>
                            </div>

                            <div class="layer-slick1 animated visible-false" data-appear="rotateIn" data-delay="1600">
                                <a asp-controller="Productos" asp-action="Index"
                                   class="flex-c-m stext-101 cl0 size-101 bor1 hov-btn1 p-lr-15 trans-04"
                                   style="background-color: #ff91c7; border-color: #ff91c7;">
                                    Ver Productos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Banner de Categorías -->
    <div class="sec-banner p-t-80 p-b-50" style="background-color: #ffe4f0;">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block1 -->
                    <div class="block1 wrap-pic-w" style="border-radius: 10px; overflow: hidden;">
                        <img src="~/images/banner-01.jpg" alt="IMG-BANNER">

                        <a asp-controller="Productos" asp-action="PorCategoria" asp-route-categoria="Tortas"
                           class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Tortas
                                </span>

                                <span class="block1-info stext-102 trans-04"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Para toda ocasión
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Ver Tortas
                                </div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block1 -->
                    <div class="block1 wrap-pic-w" style="border-radius: 10px; overflow: hidden;">
                        <img src="~/images/banner-02.jpg" alt="IMG-BANNER">

                        <a asp-controller="Productos" asp-action="PorCategoria" asp-route-categoria="Cupcakes"
                           class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Cupcakes
                                </span>

                                <span class="block1-info stext-102 trans-04"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Deliciosos y decorados
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Ver Cupcakes
                                </div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
                    <!-- Block1 -->
                    <div class="block1 wrap-pic-w" style="border-radius: 10px; overflow: hidden;">
                        <img src="~/images/banner-03.jpg" alt="IMG-BANNER">

                        <a asp-controller="Productos" asp-action="PorCategoria" asp-route-categoria="Tartas"
                           class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
                            <div class="block1-txt-child1 flex-col-l">
                                <span class="block1-name ltext-102 trans-04 p-b-8"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Tartas & Pays
                                </span>

                                <span class="block1-info stext-102 trans-04"
                                      style="color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
                                    Tradición artesanal
                                </span>
                            </div>

                            <div class="block1-txt-child2 p-b-4 trans-05">
                                <div class="block1-link stext-101 cl0 trans-09">
                                    Ver Tartas
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos Destacados -->
    <section class="p-t-23 p-b-140" style="background-color: #ffe4f0;">
        <div class="container">
            <div class="p-b-10">
                <h3 class="ltext-103" style="color: #ff91c7;">
                    Nuestros Productos Destacados
                </h3>
            </div>

            <!-- Botones de filtros -->
            <div class="flex-w flex-sb-m p-b-52">
                <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                    <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1" data-filter="*"
                            style="border-color: #ff91c7; color: #ff91c7;">
                        Todos
                    </button>

                    <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".Torta"
                            style="border-color: #ff91c7;">
                        Tortas
                    </button>

                    <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".Tarta"
                            style="border-color: #ff91c7;">
                        Tartas
                    </button>

                    <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".Pay"
                            style="border-color: #ff91c7;">
                        Pays
                    </button>

                    <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".Cupcake"
                            style="border-color: #ff91c7;">
                        Cupcakes
                    </button>
                </div>

                <div class="flex-w flex-c-m m-tb-10">
                    <a asp-controller="Productos" asp-action="Index"
                       class="flex-c-m stext-106 cl0 size-104 bor2 hov-btn3 trans-04 m-r-8 m-tb-4"
                       style="background-color: #ff91c7; border-color: #ff91c7;">
                        Ver Todos los Productos
                    </a>
                </div>
            </div>

            <!-- GRID DE PRODUCTOS -->
            <div class="row isotope-grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model.Take(12))
                    {
                        var categoriaClass = p.IdCategoriaNavigation?.Nombre?.ToLower().Replace(" ", "-") ?? "otros";
                        var imagenUrl = string.IsNullOrEmpty(p.ImagenUrl) ? "~/images/no-image.svg" : p.ImagenUrl;

                        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item @categoriaClass">
                            <div class="block2"
                                 style="background-color: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.15);">

                                <!-- Imagen + botón agregar -->
                                <div class="block2-pic hov-img0">
                                    <img src="@imagenUrl" alt="@p.Nombre" style="width:100%; height:260px; object-fit:cover;">

                                    @if (p.Stock > 0)
                                    {
                                        <button class="flex-c-m stext-103 size-102 p-lr-15 trans-04 add-to-cart-btn" data-id="@p.Id"
                                                data-nombre="@p.Nombre" data-precio="@p.Precio" data-imagen="@imagenUrl" style="
                                            background-color:#ff91c7;
                                            color:white;
                                            border:none;
                                            cursor:pointer;
                                            font-weight:bold;
                                            width:100%;
                                            ">
                                            Agregar al Carrito
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="flex-c-m stext-103 size-102" style="background-color:#999;color:#fff;">
                                            Agotado
                                        </span>
                                    }
                                </div>

                                <!-- Datos del producto -->
                                <div class="block2-txt flex-w flex-t p-t-14 p-lr-15 p-b-15">
                                    <div class="flex-col-l" style="width:100%;">
                                        <span class="stext-104 cl2 p-b-6" style="color:#333;">
                                            @p.Nombre
                                        </span>

                                        <span class="stext-105" style="color:#ff91c7;font-weight:bold;">
                                            @p.Precio.ToString("N2") Bs
                                        </span>

                                        <span class="stext-107 cl6 p-t-5" style="font-size:12px;">
                                            @p.IdCategoriaNavigation?.Nombre
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center p-t-50 p-b-50">
                        <i class="zmdi zmdi-shopping-cart" style="font-size:80px;color:#ff91c7;"></i>
                        <h3 class="mtext-111 cl2 p-t-20">No hay productos disponibles</h3>
                        <p class="stext-113 cl6">Estamos preparando deliciosos productos para ti</p>
                    </div>
                }
            </div>

            <!-- Ver más -->
            @if (Model != null && Model.Count() > 0)
            {
                <div class="flex-c-m flex-w w-full p-t-45">
                    <a asp-controller="Productos" asp-action="Index"
                       class="flex-c-m stext-101 cl0 size-103 bor1 hov-btn1 p-lr-15 trans-04"
                       style="background-color:#ff91c7;border-color:#ff91c7;">
                        Ver Todos los Productos
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- Back to top -->
    <div class="btn-back-to-top" id="myBtn" style="background-color:#ff91c7;">
        <span class="symbol-btn-back-to-top">
            <i class="zmdi zmdi-chevron-up" style="color:#fff;"></i>
        </span>
    </div>

</section>

@section Scripts {
    <script>
        // ---------------------------
        //  CARRITO LOCALSTORAGE
        // ---------------------------
        let carrito = JSON.parse(localStorage.getItem('carrito')) || [];

        function actualizarCarrito() {
            const lista = document.getElementById('cart-items-list');
            const totalCaja = document.getElementById('cart-total');

            if (!lista || !totalCaja) return;

            if (carrito.length === 0) {
                lista.innerHTML = `<li class="p-lr-15 p-tb-20"><p class="stext-113 cl6">Tu carrito está vacío</p></li>`;
                totalCaja.textContent = 'Total: 0 Bs';
                return;
            }

            let html = '';
            let total = 0;

            carrito.forEach((item, i) => {
                total += item.precio * item.cantidad;

                html += `
                    <li class="header-cart-item flex-w flex-t m-b-12">
                        <div class="header-cart-item-img">
                            <img src="${item.imagen}" style="width:80px;height:80px;object-fit:cover;">
                        </div>
                        <div class="header-cart-item-txt p-t-8">
                            <span class="header-cart-item-name m-b-18">
                                ${item.nombre}
                            </span>
                            <span class="header-cart-item-info">
                                ${item.cantidad} x ${item.precio.toFixed(2)} Bs
                            </span>
                        </div>
                        <button class="btn-remove-cart" data-index="${i}"
                                style="border:none;background:none;color:#ff91c7;font-size:20px;">
                            <i class="zmdi zmdi-close"></i>
                        </button>
                    </li>`;
            });

            lista.innerHTML = html;
            totalCaja.textContent = `Total: ${total.toFixed(2)} Bs`;

            document.querySelectorAll('.btn-remove-cart').forEach(btn => {
                btn.addEventListener('click', function () {
                    carrito.splice(parseInt(this.dataset.index), 1);
                    localStorage.setItem('carrito', JSON.stringify(carrito));
                    actualizarCarrito();
                });
            });
        }

        // ---------------------------
        //  AGREGAR PRODUCTOS DIRECTO
        // ---------------------------
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;

            const id = parseInt(btn.dataset.id);
            const nombre = btn.dataset.nombre;
            const precio = parseFloat(btn.dataset.precio);
            const imagen = btn.dataset.imagen;

            const exists = carrito.find(p => p.id === id);

            if (exists) {
                exists.cantidad++;
            } else {
                carrito.push({
                    id,
                    nombre,
                    precio,
                    imagen,
                    cantidad: 1
                });
            }

            localStorage.setItem('carrito', JSON.stringify(carrito));
            actualizarCarrito();

            swal(nombre, "¡Agregado al carrito!", "success");
        });

        document.addEventListener('DOMContentLoaded', actualizarCarrito);

        // ------------------------------------------------------
        // FILTRADO DE PRODUCTOS POR CATEGORÍA - ISOTOPE
        // ------------------------------------------------------
        $(document).ready(function () {

            // Inicializar Isotope
            var $grid = $('.isotope-grid').isotope({
                itemSelector: '.isotope-item',
                layoutMode: 'fitRows'
            });

            // Activar botones de categoría
            $('.filter-tope-group').on('click', 'button', function () {
                var filtro = $(this).attr('data-filter');

                // Activar botón seleccionado
                $('.filter-tope-group button').removeClass('how-active1');
                $(this).addClass('how-active1');

                // Filtrar productos
                $grid.isotope({ filter: filtro });
            });
        });
    </script>
}
