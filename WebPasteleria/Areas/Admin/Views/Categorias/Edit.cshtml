@model CategoriaFormViewModel
@{
    ViewBag.Title = "Editar categoría";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header"><h3>Editar categoría</h3></div>

    <form asp-action="Edit" method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="admin-summary-error"></div>
        <input type="hidden" asp-for="Id" />

        <div class="admin-field">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" type="text" maxlength="50" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>

        <div class="admin-field">
            <label asp-for="Estado"></label>
            <select asp-for="Estado">
                <option value="1">Activa</option>
                <option value="0">Inactiva</option>
            </select>
            <span asp-validation-for="Estado" class="field-error"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
