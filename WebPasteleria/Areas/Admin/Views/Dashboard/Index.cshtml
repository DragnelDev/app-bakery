@model DashboardViewModel
@{
    ViewBag.Title = "Dashboard Principal";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@functions {
    static string ClaseEstado(byte estado) => estado switch
    {
        PedidoEstado.Entregado => "delivered",
        PedidoEstado.Cancelado => "cancelled",
        PedidoEstado.EnPreparacion or PedidoEstado.ListoParaEntrega or PedidoEstado.EnCamino => "prepared",
        _ => "pending"
    };
}

<!-- TARJETAS KPI -->
<section class="kpi-cards">
    <div class="card kpi-card">
        <div class="icon"><i class="fas fa-sack-dollar"></i></div>
        <div class="details">
            <p class="label">Ventas Hoy</p>
            <p class="value">Bs @Model.VentasHoy.ToString("N2")</p>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="icon"><i class="fas fa-box-open"></i></div>
        <div class="details">
            <p class="label">Pedidos Pendientes</p>
            <p class="value">@Model.PedidosPendientes</p>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="icon"><i class="fas fa-calendar-check"></i></div>
        <div class="details">
            <p class="label">Entregas Mañana</p>
            <p class="value">@Model.EntregasManana</p>
        </div>
    </div>
</section>

<!-- ÓRDENES RECIENTES -->
<section class="main-table-container">
    <div class="card">
        <h3>Órdenes Recientes</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Productos</th>
                    <th>Total</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrdenesRecientes.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="admin-empty">No hay órdenes recientes</td>
                    </tr>
                }
                @foreach (var orden in Model.OrdenesRecientes)
                {
                    <tr>
                        <td>#@orden.Id</td>
                        <td>@orden.NombreCliente</td>
                        <td>@orden.Productos</td>
                        <td>Bs @orden.Total.ToString("N2")</td>
                        <td><span class="status-badge @ClaseEstado(orden.EstadoCodigo)">@orden.EstadoNombre</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <a asp-area="Admin" asp-controller="Pedidos" asp-action="Index" class="view-all">Ver todos los pedidos →</a>
    </div>
</section>
