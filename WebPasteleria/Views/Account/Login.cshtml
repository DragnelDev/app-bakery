@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg border-0" style="width: 380px; border-radius: 15px;">
        <div class="card-body p-4">

            <h3 class="text-center mb-3 fw-bold">Iniciar Sesión</h3>
            <p class="text-center text-muted mb-4">Ingresa tus credenciales para continuar</p>

            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>

                <!-- SUMMARY VALIDATION -->
                <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                <!-- USERNAME -->
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label fw-semibold"></label>
                    <input asp-for="Usuario" class="form-control" placeholder="Usuario" />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>

                <!-- PASSWORD -->
                <div class="mb-3">
                    <label asp-for="Clave" class="form-label fw-semibold"></label>
                    <input asp-for="Clave" type="password" class="form-control" placeholder="Contraseña" />
                    <span asp-validation-for="Clave" class="text-danger small"></span>
                </div>

                <!-- REMEMBER ME + SUBMIT -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input type="checkbox" name="recordarme" id="recordarme" class="form-check-input" />
                        <label class="form-check-label" for="recordarme">Recordarme</label>
                    </div>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-box-arrow-in-right"></i> Ingresar
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
