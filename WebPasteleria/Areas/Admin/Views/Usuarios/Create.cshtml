@model UsuarioFormViewModel
@{
    ViewBag.Title = "Nuevo usuario";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header">
        <h3>Nuevo usuario</h3>
    </div>

    <form asp-action="Create" method="post" class="admin-form" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="admin-summary-error"></div>
        <partial name="_Campos" model="Model" />
        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Crear usuario</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
