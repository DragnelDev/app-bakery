@model IEnumerable<Usuario>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="admin-page-header">
        <h3>Usuarios del sistema</h3>
        <a asp-action="Create" class="admin-btn admin-btn-primary"><i class="fas fa-plus"></i> Nuevo usuario</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Empleado</th>
                <th>Rol</th>
                <th>Último acceso</th>
                <th>Intentos fallidos</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="admin-empty">No hay usuarios registrados</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Usuario1</td>
                    <td>@item.IdEmpleadoNavigation.Nombre @item.IdEmpleadoNavigation.ApellidoPaterno</td>
                    <td>@item.Role</td>
                    <td>@(item.UltimoLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>@(item.IntentosFallidos ?? 0)</td>
                    <td>
                        <span class="status-badge @(item.Estado == EstadoRegistro.Activo ? "delivered" : "pending")">
                            @(item.Estado == EstadoRegistro.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
