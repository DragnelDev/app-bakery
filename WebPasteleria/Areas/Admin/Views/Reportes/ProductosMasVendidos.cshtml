@model ReporteProductosViewModel
@{
    ViewBag.Title = "Productos más vendidos";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<partial name="_ReportesTabs" />

<div class="card">
    <div class="admin-page-header">
        <h3>Productos más vendidos</h3>
    </div>
    <partial name="_FiltroFechas" model="Model.Rango" />

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Producto</th>
                <th>Unidades</th>
                <th>Ingresos (Bs)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Filas.Count == 0)
            {
                <tr>
                    <td colspan="4" class="admin-empty">No hay ventas en el rango seleccionado</td>
                </tr>
            }
            @for (var i = 0; i < Model.Filas.Count; i++)
            {
                var fila = Model.Filas[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@fila.Nombre</td>
                    <td>@fila.Unidades</td>
                    <td>@fila.Ingresos.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
