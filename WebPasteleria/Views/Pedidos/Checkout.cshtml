@{
    ViewData["Title"] = "Finalizar Compra - Pastelería Carmen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="background-color: #ffe4f0;">
    <!-- Breadcrumb -->
    <div class="container">
        <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
            <a asp-controller="Home" asp-action="Index" class="stext-109 cl8 hov-cl1 trans-04">
                Inicio
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>

            <a asp-controller="Home" asp-action="Carrito" class="stext-109 cl8 hov-cl1 trans-04">
                Carrito
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>

            <span class="stext-109 cl4">
                Finalizar Compra
            </span>
        </div>
    </div>

    <!-- Checkout -->
    <div class="p-t-75 p-b-85">
        <div class="container">
            <!-- Empty Cart Warning -->
            <div id="empty-cart-warning" class="alert alert-warning text-center" style="display: none;">
                <i class="zmdi zmdi-shopping-cart" style="font-size: 50px;"></i>
                <h4 class="m-t-20">Tu carrito está vacío</h4>
                <p>Agrega productos antes de finalizar tu compra</p>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-primary"
                    style="background-color: #ff91c7; border-color: #ff91c7;">
                    Ver Productos
                </a>
            </div>

            <div class="row" id="checkout-content">
                <!-- Formulario de Datos -->
                <div class="col-lg-7 m-b-50">
                    <div class="bor10 p-lr-40 p-t-30 p-b-40"
                        style="background-color: #fff; border-radius: 10px; border-color: #ff91c7;">
                        <h4 class="mtext-109 cl2 p-b-30">
                            <i class="fa fa-user" style="color: #ff91c7;"></i> Datos del Cliente
                        </h4>

                        <form id="checkout-form" novalidate>
                            @Html.AntiForgeryToken()
                            <!-- Datos Personales -->
                            <div class="row">
                                <div class="col-md-6 m-b-20">
                                    <label class="stext-111 cl2 p-b-10">Nombre Completo *</label>
                                    <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="text"
                                        id="nombre-cliente" name="nombreCliente" placeholder="Juan Pérez" required>
                                </div>

                                <div class="col-md-6 m-b-20">
                                    <label class="stext-111 cl2 p-b-10">Cédula de Identidad</label>
                                    <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="text"
                                        id="cedula-cliente" name="cedulaCliente" placeholder="1234567">
                                </div>

                                <div class="col-md-6 m-b-20">
                                    <label class="stext-111 cl2 p-b-10">Correo Electrónico *</label>
                                    <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="email"
                                        id="email-cliente" name="emailCliente" placeholder="correo@ejemplo.com"
                                        required>
                                </div>

                                <div class="col-md-6 m-b-20">
                                    <label class="stext-111 cl2 p-b-10">Teléfono / WhatsApp *</label>
                                    <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="tel"
                                        id="telefono-cliente" name="celularCliente" placeholder="78901234" required>
                                </div>
                            </div>

                            <!-- Tipo de Entrega -->
                            <div class="m-t-30 m-b-30">
                                <h5 class="mtext-110 cl2 p-b-20">
                                    <i class="fa fa-truck" style="color: #ff91c7;"></i> Tipo de Entrega
                                </h5>

                                <div class="row">
                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; transition: all 0.3s; padding: 20px;"
                                            onclick="seleccionarEntrega('RECOGER')">
                                            <input type="radio" name="tipoEntrega" id="entrega-recoger" value="RECOGER"
                                                checked>
                                            <label for="entrega-recoger" style="cursor: pointer; margin-left: 10px;">
                                                <strong>Recoger en Tienda</strong><br>
                                                <small>Av. Jaime Mendoza 456, Sucre</small><br>
                                                <span style="color: #28a745;">Gratis</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; transition: all 0.3s; padding: 20px;"
                                            onclick="seleccionarEntrega('DOMICILIO')">
                                            <input type="radio" name="tipoEntrega" id="entrega-domicilio"
                                                value="DOMICILIO">
                                            <label for="entrega-domicilio" style="cursor: pointer; margin-left: 10px;">
                                                <strong>Entrega a Domicilio</strong><br>
                                                <small>En Sucre y alrededores</small><br>
                                                <span style="color: #ff91c7;">15 - 25 Bs</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dirección (Solo si es entrega a domicilio) -->
                            <div id="direccion-entrega" style="display: none;">
                                <h5 class="mtext-110 cl2 p-b-20">
                                    <i class="fa fa-map-marker" style="color: #ff91c7;"></i> Dirección de Entrega
                                </h5>

                                <div class="row">
                                    <div class="col-12 m-b-20">
                                        <label class="stext-111 cl2 p-b-10">Dirección Completa *</label>
                                        <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="text"
                                            id="direccion-cliente" name="direccion"
                                            placeholder="Calle Principal #123, Zona Norte">
                                    </div>

                                    <div class="col-md-6 m-b-20">
                                        <label class="stext-111 cl2 p-b-10">Zona</label>
                                        <select class="stext-111 cl2 size-111 p-lr-15 bor8" id="zona-entrega"
                                            name="zona">
                                            <option value="Centro">Centro (15 Bs)</option>
                                            <option value="Norte">Zona Norte (20 Bs)</option>
                                            <option value="Sur">Zona Sur (20 Bs)</option>
                                            <option value="Este">Zona Este (25 Bs)</option>
                                            <option value="Oeste">Zona Oeste (25 Bs)</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6 m-b-20">
                                        <label class="stext-111 cl2 p-b-10">Referencia</label>
                                        <input class="stext-111 cl2 plh3 size-111 p-lr-15 bor8" type="text"
                                            id="referencia" name="referencia" placeholder="Cerca del mercado central">
                                    </div>
                                </div>
                            </div>

                            <!-- Método de Pago -->
                            <div class="m-t-30">
                                <h5 class="mtext-110 cl2 p-b-20">
                                    <i class="fa fa-credit-card" style="color: #ff91c7;"></i> Método de Pago
                                </h5>

                                <div class="row">
                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; padding: 20px;">
                                            <input type="radio" name="metodoPago" id="pago-efectivo" value="1" checked>
                                            <label for="pago-efectivo" style="cursor: pointer; margin-left: 10px;">
                                                <i class="fa fa-money" style="color: #28a745;"></i>
                                                <strong> Efectivo</strong><br>
                                                <small>Pago al recoger o recibir</small>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; padding: 20px;">
                                            <input type="radio" name="metodoPago" id="pago-tarjeta" value="2">
                                            <label for="pago-tarjeta" style="cursor: pointer; margin-left: 10px;">
                                                <i class="fa fa-credit-card" style="color: #ff91c7;"></i>
                                                <strong> Tarjeta</strong><br>
                                                <small>Crédito o Débito</small>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; padding: 20px;">
                                            <input type="radio" name="metodoPago" id="pago-transferencia" value="3">
                                            <label for="pago-transferencia" style="cursor: pointer; margin-left: 10px;">
                                                <i class="fa fa-bank" style="color: #007bff;"></i>
                                                <strong> Transferencia</strong><br>
                                                <small>Banco o QR</small>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 m-b-15">
                                        <div class="bor8" style="cursor: pointer; padding: 20px;">
                                            <input type="radio" name="metodoPago" id="pago-qr" value="4">
                                            <label for="pago-qr" style="cursor: pointer; margin-left: 10px;">
                                                <i class="fa fa-qrcode" style="color: #ff6b6b;"></i>
                                                <strong> QR</strong><br>
                                                <small>Pago simple QR</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Observaciones -->
                            <div class="m-t-30">
                                <label class="stext-111 cl2 p-b-10">Observaciones / Instrucciones Especiales</label>
                                <textarea class="stext-111 cl2 plh3 p-lr-15 p-tb-10 bor8" id="observaciones"
                                    name="observaciones" rows="4"
                                    placeholder="Ej: Pastel con mensaje personalizado, sin nueces, entrega en horario específico, etc."></textarea>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Resumen del Pedido -->
                <div class="col-lg-5 m-b-50">
                    <div class="bor10 p-lr-40 p-t-30 p-b-40"
                        style="background-color: #fff; border-radius: 10px; border-color: #ff91c7; position: sticky; top: 20px;">
                        <h4 class="mtext-109 cl2 p-b-30">
                            <i class="fa fa-shopping-cart" style="color: #ff91c7;"></i> Tu Pedido
                        </h4>

                        <!-- Productos -->
                        <div id="checkout-productos" class="m-b-20" style="max-height: 300px; overflow-y: auto;">
                            <!-- Los productos se cargarán aquí -->
                        </div>

                        <!-- Totales -->
                        <div class="flex-w flex-t bor12 p-t-15 p-b-13">
                            <div class="size-208">
                                <span class="stext-110 cl2">Subtotal:</span>
                            </div>
                            <div class="size-209">
                                <span class="stext-110 cl2" id="checkout-subtotal">0.00 Bs</span>
                            </div>
                        </div>

                        <div class="flex-w flex-t bor12 p-t-15 p-b-13" id="checkout-descuento-section"
                            style="display: none;">
                            <div class="size-208">
                                <span class="stext-110 cl2">Descuento:</span>
                            </div>
                            <div class="size-209">
                                <span class="stext-110" style="color: #28a745;" id="checkout-descuento">-0.00 Bs</span>
                            </div>
                        </div>

                        <div class="flex-w flex-t bor12 p-t-15 p-b-13">
                            <div class="size-208">
                                <span class="stext-110 cl2">Envío:</span>
                            </div>
                            <div class="size-209">
                                <span class="stext-110 cl2" id="checkout-envio">0.00 Bs</span>
                            </div>
                        </div>

                        <div class="flex-w flex-t p-t-27 p-b-33">
                            <div class="size-208">
                                <span class="mtext-101 cl2">Total:</span>
                            </div>
                            <div class="size-209 p-t-1">
                                <span class="mtext-110" style="color: #ff91c7;" id="checkout-total">0.00 Bs</span>
                            </div>
                        </div>

                        <!-- Botón Finalizar -->
                        <button type="button" id="btn-finalizar-pedido"
                            class="flex-c-m stext-101 cl0 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer"
                            style="background-color: #ff91c7; border-color: #ff91c7;">
                            <i class="fa fa-check"></i> Finalizar Pedido
                        </button>

                        <a asp-controller="Home" asp-action="Carrito"
                            class="flex-c-m stext-101 cl2 size-116 bor14 hov-btn3 p-lr-15 trans-04 pointer m-t-15"
                            style="border-color: #ff91c7; color: #ff91c7; display: block; text-align: center;">
                            <i class="fa fa-arrow-left"></i> Volver al Carrito
                        </a>

                        <!-- Términos y Condiciones -->
                        <div class="m-t-20">
                            <label style="font-size: 12px; color: #666;">
                                <input type="checkbox" id="terminos-checkbox" required>
                                Acepto los <a href="#" style="color: #ff91c7;">términos y condiciones</a> y la política
                                de privacidad
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Respirar profundo... ✔️

        // Variables y utilidades
        let carrito = [];
        try {
            carrito = JSON.parse(localStorage.getItem('carrito')) || [];
            if (!Array.isArray(carrito)) carrito = [];
        } catch (e) {
            console.warn('Carrito inválido en localStorage, se inicializa vacío.', e);
            carrito = [];
        }

        let costoEnvio = 0;

        // Obtener token Antiforgery desde el formulario
        function obtenerTokenAntiforgery() {
            // Buscar en el formulario
            const form = document.getElementById('checkout-form');
            if (form) {
                const input = form.querySelector('input[name="__RequestVerificationToken"]');
                if (input) return input.value;
            }
            // Buscar en todo el documento como fallback
            const globalInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return globalInput ? globalInput.value : null;
        }

        // Mostrar/ocultar contenido según carrito
        function verificarCarrito() {
            const empty = document.getElementById('empty-cart-warning');
            const content = document.getElementById('checkout-content');

            if (!Array.isArray(carrito) || carrito.length === 0) {
                if (empty) empty.style.display = 'block';
                if (content) content.style.display = 'none';
                return false;
            }

            if (empty) empty.style.display = 'none';
            if (content) content.style.display = 'flex';
            return true;
        }

        // Renderizar productos
        function renderizarCheckout() {
            const productosContainer = document.getElementById('checkout-productos');
            if (!productosContainer) return;

            let html = '';
            carrito.forEach(item => {
                const nombre = item.nombre || 'Producto';
                const imagen = item.imagen || '';
                const cantidad = Number(item.cantidad) || 0;
                const precio = Number(item.precio) || 0;

                html += `
                        <div class="flex-w flex-t p-b-13 bor12">
                            <div class="size-208">
                                <img src="${imagen}" alt="${nombre}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                            </div>
                            <div class="size-209">
                                <span class="stext-110 cl2">${nombre}</span><br>
                                <span class="stext-111 cl6">${cantidad} x ${precio.toFixed(2)} Bs</span>
                            </div>
                        </div>
                    `;
            });

            productosContainer.innerHTML = html;
            calcularTotales();
        }

        // Calcular totales con conversiones seguras
        function calcularTotales() {
            const subtotal = carrito.reduce((total, item) => {
                const precio = Number(item.precio) || 0;
                const cantidad = Number(item.cantidad) || 0;
                return total + (precio * cantidad);
            }, 0);

            const descuento = parseFloat(localStorage.getItem('descuentoCarrito') || 0) || 0;
            const total = subtotal - descuento + costoEnvio;

            const elSubtotal = document.getElementById('checkout-subtotal');
            const elEnvio = document.getElementById('checkout-envio');
            const elTotal = document.getElementById('checkout-total');
            const elDescuentoSection = document.getElementById('checkout-descuento-section');
            const elDescuento = document.getElementById('checkout-descuento');

            if (elSubtotal) elSubtotal.textContent = subtotal.toFixed(2) + ' Bs';
            if (elEnvio) elEnvio.textContent = costoEnvio.toFixed(2) + ' Bs';
            if (elTotal) elTotal.textContent = total.toFixed(2) + ' Bs';

            if (descuento > 0) {
                if (elDescuentoSection) elDescuentoSection.style.display = 'flex';
                if (elDescuento) elDescuento.textContent = '-' + descuento.toFixed(2) + ' Bs';
            } else {
                if (elDescuentoSection) elDescuentoSection.style.display = 'none';
            }
        }

        // Selección de entrega (onclick en la UI + change en radios)
        function seleccionarEntrega(tipo) {
            const entregaRecoger = document.getElementById('entrega-recoger');
            const entregaDomicilio = document.getElementById('entrega-domicilio');
            const direccionDiv = document.getElementById('direccion-entrega');

            if (tipo === 'RECOGER') {
                if (entregaRecoger) entregaRecoger.checked = true;
                if (direccionDiv) direccionDiv.style.display = 'none';
                costoEnvio = 0;
            } else {
                if (entregaDomicilio) entregaDomicilio.checked = true;
                if (direccionDiv) direccionDiv.style.display = 'block';
                const zonaSelect = document.getElementById('zona-entrega');
                const zona = zonaSelect ? zonaSelect.value : 'Centro';
                if (zona === 'Centro') costoEnvio = 15;
                else if (zona === 'Norte' || zona === 'Sur') costoEnvio = 20;
                else costoEnvio = 25;
            }
            calcularTotales();
        }

        // Inicialización
        document.addEventListener('DOMContentLoaded', function () {
            if (!verificarCarrito()) return;

            renderizarCheckout();

            const zonaSelect = document.getElementById('zona-entrega');
            if (zonaSelect) {
                zonaSelect.addEventListener('change', function () {
                    const zona = this.value;
                    if (zona === 'Centro') costoEnvio = 15;
                    else if (zona === 'Norte' || zona === 'Sur') costoEnvio = 20;
                    else costoEnvio = 25;
                    calcularTotales();
                });
            }

            document.querySelectorAll('input[name="tipoEntrega"]').forEach(r => {
                r.addEventListener('change', function (e) {
                    seleccionarEntrega(e.target.value);
                });
            });

            // Si por alguna razón DOM ya seleccionó domicilio
            const seleccionado = document.querySelector('input[name="tipoEntrega"]:checked');
            if (seleccionado && seleccionado.value === 'DOMICILIO') seleccionarEntrega('DOMICILIO');

            const btn = document.getElementById('btn-finalizar-pedido');
            if (btn) btn.addEventListener('click', finalizarPedido);
        });

        // Envío del pedido al servidor
        async function finalizarPedido() {
            const btnFinalizar = document.getElementById('btn-finalizar-pedido');
            try {
                // Validaciones básicas
                const terminos = document.getElementById('terminos-checkbox');
                if (!terminos || !terminos.checked) {
                    swal("Atención", "Debes aceptar los términos y condiciones", "warning");
                    return;
                }

                const nombreCliente = (document.getElementById('nombre-cliente') || {}).value?.trim() || '';
                const emailCliente = (document.getElementById('email-cliente') || {}).value?.trim() || '';
                const celularCliente = (document.getElementById('telefono-cliente') || {}).value?.trim() || '';

                if (!nombreCliente || !emailCliente || !celularCliente) {
                    swal("Campos requeridos", "Por favor completa todos los campos obligatorios", "warning");
                    return;
                }

                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(emailCliente)) {
                    swal("Email inválido", "Por favor ingresa un correo electrónico válido", "error");
                    return;
                }

                const tipoEntrega = (document.querySelector('input[name="tipoEntrega"]:checked') || {}).value || 'RECOGER';
                let direccion = null;
                let zona = null;
                
                if (tipoEntrega === 'DOMICILIO') {
                    direccion = (document.getElementById('direccion-cliente') || {}).value?.trim() || null;
                    zona = (document.getElementById('zona-entrega') || {}).value || 'Centro';
                    if (!direccion) {
                        swal("Dirección requerida", "Por favor ingresa tu dirección de entrega", "warning");
                        return;
                    }
                }

                // Preparar payload
                const productosPayload = carrito.map(item => ({
                    idProducto: item.id,
                    cantidad: Number(item.cantidad) || 0,
                    precioUnitario: Number(item.precio) || 0
                }));

                const subtotal = productosPayload.reduce((t, p) => t + (p.precioUnitario * p.cantidad), 0);
                const descuento = parseFloat(localStorage.getItem('descuentoCarrito') || 0) || 0;
                const total = subtotal - descuento + costoEnvio;

                const pedido = {
                    nombreCliente,
                    emailCliente,
                    celularCliente,
                    cedulaIdentidad: (document.getElementById('cedula-cliente') || {}).value?.trim() || null,
                    tipoEntrega,
                    direccion,
                    metodoPago: parseInt((document.querySelector('input[name="metodoPago"]:checked') || {}).value || '1'),
                    observaciones: (document.getElementById('observaciones') || {}).value?.trim() || null,
                    productos: productosPayload,
                    subtotal,
                    descuento,
                    costoEnvio,
                    total
                };

                if (btnFinalizar) {
                    btnFinalizar.disabled = true;
                    btnFinalizar.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Procesando...';
                }

                // Log para debugging
                console.log('Pedido a enviar:', pedido);
                console.log('Token antiforgery:', obtenerTokenAntiforgery() ? 'Presente' : 'No encontrado');

                // Antiforgery token si existe
                const token = obtenerTokenAntiforgery();
                const headers = { 
                    'Content-Type': 'application/json'
                };
                if (token) {
                    headers['RequestVerificationToken'] = token;
                }

                console.log('Enviando petición a /Pedidos/CrearPedido');

                const response = await fetch('/Pedidos/CrearPedido', {
                    method: 'POST',
                    headers,
                    body: JSON.stringify(pedido)
                });

                console.log('Respuesta del servidor:', response.status);

                if (!response.ok) {
                    let msg = `Error en la petición (${response.status})`;
                    try {
                        const errJson = await response.json();
                        msg = errJson.mensaje || errJson.error || JSON.stringify(errJson);
                        console.error('Error del servidor:', errJson);
                    } catch {
                        try { 
                            msg = await response.text(); 
                            console.error('Error (texto):', msg);
                        } catch { /* ignore */ }
                    }
                    throw new Error(msg);
                }

                const result = await response.json();
                console.log('Resultado del pedido:', result);
                console.log('success:', result.success);
                console.log('idPedido:', result.idPedido);
                console.log('codigoSeguimiento:', result.codigoSeguimiento);

                if (result && result.success === true) {
                    console.log('Pedido creado exitosamente, limpiando localStorage...');
                    localStorage.removeItem('carrito');
                    localStorage.removeItem('descuentoCarrito');

                    // Mostrar alerta y redirigir después
                    swal({
                        title: "¡Pedido Realizado!",
                        text: `Tu pedido #${result.codigoSeguimiento} ha sido registrado exitosamente. Te enviaremos un correo de confirmación.`,
                        icon: "success",
                        button: "Ver Detalles",
                        closeOnClickOutside: false,
                        closeOnEsc: false
                    }).then((value) => {
                        console.log('SweetAlert cerrado, redirigiendo a BuscarPedido');
                        // Redirigir a la página de búsqueda/seguimiento de pedidos
                        window.location.href = '/Pedidos/BuscarPedido';
                    });
                } else {
                    const mensaje = (result && (result.mensaje || result.error)) || 'Error al procesar el pedido: respuesta incompleta';
                    console.error('Error en respuesta:', mensaje, result);
                    throw new Error(mensaje);
                }
            } catch (error) {
                console.error('Error al finalizar pedido:', error);
                swal("Error", error.message || "Hubo un problema al procesar tu pedido. Por favor intenta nuevamente.", "error");
                const btn = document.getElementById('btn-finalizar-pedido');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-check"></i> Finalizar Pedido';
                }
            }
        }
    </script>
}